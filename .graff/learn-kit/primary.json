er.","check":{"cmd":"test \"$(cat ids2.txt)\" = 'k2a\nk2b\nk2c'"},"setup_files":{"ids2.txt":"k2a\nk2b\nk2a\nk2c\nk2b\n"}},"critical":true,"statistical_unit_id":"edit-dedupe"},{"id":"edit-dedupe-random-3","payload":{"id":"edit-dedupe-random-3","task":"Deduplicate ids3.txt in place, preserving first-occurrence order.","check":{"cmd":"test \"$(cat ids3.txt)\" = 'k3a\nk3b\nk3c'"},"setup_files":{"ids3.txt":"k3a\nk3b\nk3a\nk3c\nk3b\n"}},"critical":true,"statistical_unit_id":"edit-dedupe"},{"id":"edit-dedupe-random-4","payload":{"id":"edit-dedupe-random-4","task":"Deduplicate ids4.txt in place, preserving first-occurrence order.","check":{"cmd":"test \"$(cat ids4.txt)\" = 'k4a\nk4b\nk4c'"},"setup_files":{"ids4.txt":"k4a\nk4b\nk4a\nk4c\nk4b\n"}},"critical":true,"statistical_unit_id":"edit-dedupe"},{"id":"edit-copy-random-0","payload":{"id":"edit-copy-random-0","task":"Read desired0.ini and update only limit in runtime0.ini to match it.","check":{"cmd":"grep -q '^name=worker0$' runtime0.ini && grep -q '^limit=8832$' runtime0.ini"},"setup_files":{"desired0.ini":"limit=8832\n","runtime0.ini":"name=worker0\nlimit=10\n"}},"critical":true,"statistical_unit_id":"edit-copy"},{"id":"edit-copy-random-1","payload":{"id":"edit-copy-random-1","task":"Read desired1.ini and update only limit in runtime1.ini to match it.","check":{"cmd":"grep -q '^name=worker1$' runtime1.ini && grep -q '^limit=6558$' runtime1.ini"},"setup_files":{"desired1.ini":"limit=6558\n","runtime1.ini":"name=worker1\nlimit=10\n"}},"critical":true,"statistical_unit_id":"edit-copy"},{"id":"edit-copy-random-2","payload":{"id":"edit-copy-random-2","task":"Read desired2.ini and update only limit in runtime2.ini to match it.","check":{"cmd":"grep -q '^name=worker2$' runtime2.ini && grep -q '^limit=6044$' runtime2.ini"},"setup_files":{"desired2.ini":"limit=6044\n","runtime2.ini":"name=worker2\nlimit=10\n"}},"critical":true,"statistical_unit_id":"edit-copy"},{"id":"edit-copy-random-3","payload":{"id":"edit-copy-random-3","tas