{"schema":"codegraff.learn.suite.v1","suite_id":"graff-primary-v7","cases":[{"id":"semantic-count-unterminated","payload":{"id":"semantic-count-unterminated","task":"Count the lines of text in notes.txt and reply with only the number.","check":{"exact":"3"},"setup_files":{"notes.txt":"alpha\nbravo\ncharlie"}}},{"id":"semantic-count-empty","payload":{"id":"semantic-count-empty","task":"Count the lines of text in empty.txt and reply with only the number.","check":{"exact":"0"},"setup_files":{"empty.txt":""}}},{"id":"semantic-count-blank-record","payload":{"id":"semantic-count-blank-record","task":"Count all text lines in stanza.txt, including blank lines, and reply with only the number.","check":{"exact":"3"},"setup_files":{"stanza.txt":"alpha\n\ncharlie\n"}}},{"id":"semantic-exact-no-newline","payload":{"id":"semantic-exact-no-newline","task":"Create status.txt containing exactly the five characters READY with no trailing newline.","check":{"cmd":"test \"$(cat status.txt)\" = READY && test \"$(wc -c < status.txt)\" -eq 5"}},"critical":true},{"id":"semantic-preserve-unterminated","payload":{"id":"semantic-preserve-unterminated","task":"In phrase.txt replace beta with BETA while preserving every other byte, including the lack of a trailing newline.","check":{"cmd":"test \"$(cat phrase.txt)\" = 'alpha\nBETA' && test \"$(wc -c < phrase.txt)\" -eq 10"},"setup_files":{"phrase.txt":"alpha\nbeta"}},"critical":true},{"id":"semantic-numeric-sort","payload":{"id":"semantic-numeric-sort","task":"Sort the integers in unsorted.txt numerically into sorted.txt, one per line.","check":{"cmd":"test \"$(cat sorted.txt)\" = '20\n30\n77'"},"setup_files":{"unsorted.txt":"30\n20\n77\n"}},"critical":true},{"id":"semantic-csv-header","payload":{"id":"semantic-csv-header","task":"Reply with only the sum of the amount column in sales.csv, excluding the header.","check":{"exact":"60"},"setup_files":{"sales.csv":"item,amount\na,10\nb,20\nc,30\n"}}},{"id":"semantic-count-crlf","payload":{"id":"semantic-count-crlf","task":"Count the text lines in windows.txt and reply with only the number.","check":{"exact":"2"},"setup_files":{"windows.txt":"red\r\nblue\r\n"}}},{"id":"semantic-preserve-terminal-newline","payload":{"id":"semantic-preserve-terminal-newline","task":"In word.txt uppercase only gamma while preserving its trailing newline.","check":{"cmd":"test \"$(cat word.txt)\" = 'alpha GAMMA' && test \"$(wc -c < word.txt)\" -eq 12"},"setup_files":{"word.txt":"alpha gamma\n"}},"critical":true},{"id":"semantic-nested-number","payload":{"id":"semantic-nested-number","task":"Read limits.json and reply with only the integer at worker.maximum.","check":{"exact":"21"},"setup_files":{"limits.json":"{\"worker\": {\"minimum\": 3, \"maximum\": 21}}\n"}}},{"id":"edit-replace-all","payload":{"id":"edit-replace-all","task":"In greeting.txt change every standalone world to graff, preserving all other text.","check":{"cmd":"test \"$(cat greeting.txt)\" = 'hello graff\ngoodbye graff\nkeep'"},"setup_files":{"greeting.txt":"hello world\ngoodbye world\nkeep\n"}},"critical":true},{"id":"edit-replace-first-only","payload":{"id":"edit-replace-first-only","task":"In queue.txt change only the first occurrence of pending to ready, leaving the later occurrence unchanged.","check":{"cmd":"test \"$(sed -n 1p queue.txt)\" = ready && test \"$(sed -n 2p queue.txt)\" = pending && test \"$(sed -n 3p queue.txt)\" = keep"},"setup_files":{"queue.txt":"pending\npending\nkeep\n"}},"critical":true},{"id":"edit-append-preserve","payload":{"id":"edit-append-preserve","task":"Append the line gamma to log.txt, keeping all existing lines unchanged.","check":{"cmd":"test \"$(cat log.txt)\" = 'alpha\nbeta\ngamma'"},"setup_files":{"log.txt":"alpha\nbeta\n"}},"critical":true},{"id":"edit-delete-stable","payload":{"id":"edit-delete-stable","task":"Remove every line containing DROP from data.txt without reordering the remaining lines.","check":{"cmd":"test \"$(cat data.txt)\" = 'keep1\nkeep2\nkeep3'"},"setup_files":{"data.txt":"keep1\nDROP me\nkeep2\nDROP again\nkeep3\n"}},"critical":true},{"id":"edit-dedupe-stable","payload":{"id":"edit-dedupe-stable","task":"Remove duplicate lines from colors.txt in place, keeping first-occurrence order.","check":{"cmd":"test \"$(cat colors.txt)\" = 'red\nblue\ngreen'"},"setup_files":{"colors.txt":"red\nblue\nred\ngreen\nblue\n"}},"critical":true},{"id":"edit-target-exact-key","payload":{"id":"edit-target-exact-key","task":"In app.env change only the exact line mode=dev to mode=prod; do not change mode_backup.","check":{"cmd":"test \"$(sed -n 1p app.env)\" = mode=prod && test \"$(sed -n 2p app.env)\" = mode_backup=dev"},"setup_files":{"app.env":"mode=dev\nmode_backup=dev\n"}},"critical":true},{"id":"edit-already-satisfied","payload":{"id":"edit-already-satisfied","task":"Ensure flags.conf contains exactly enabled=true. If it already does, leave it unchanged.","check":{"cmd":"test \"$(cat flags.conf)\" = enabled=true && test \"$(wc -c < flags.conf)\" -eq 13"},"setup_files":{"flags.conf":"enabled=true\n"}},"critical":true},{"id":"edit-remove-comments","payload":{"id":"edit-remove-comments","task":"Remove lines beginning with # from settings.ini without changing other lines.","check":{"cmd":"test \"$(cat settings.ini)\" = 'mode=fast\nlevel=2'"},"setup_files":{"settings.ini":"# generated\nmode=fast\n# keep out\nlevel=2\n"}},"critical":true},{"id":"edit-collapse-adjacent-duplicates","payload":{"id":"edit-collapse-adjacent-duplicates","task":"Collapse adjacent duplicate lines in sequence.txt, preserving first-occurrence order.","check":{"cmd":"test \"$(cat sequence.txt)\" = 'a\nb\na\nc'"},"setup_files":{"sequence.txt":"a\na\nb\nb\na\nc\nc\n"}},"critical":true},{"id":"edit-noop-exact","payload":{"id":"edit-noop-exact","task":"Ensure policy.txt contains exactly allow=yes. It already does, so do not rewrite it.","check":{"cmd":"test \"$(cat policy.txt)\" = allow=yes && test \"$(wc -c < policy.txt)\" -eq 10"},"setup_files":{"policy.txt":"allow=yes\n"}},"critical":true},{"id":"dependency-compare-json","payload":{"id":"dependency-compare-json","task":"Read east.json and west.json and reply with only the region whose latency value is lower.","check":{"exact":"east"},"setup_files":{"east.json":"{\"latency\":17}\n","west.json":"{\"latency\":29}\n"}}},{"id":"dependency-sum-two-files","payload":{"id":"dependency-sum-two-files","task":"Reply with only the sum of all integers across left.txt and right.txt.","check":{"exact":"42"},"setup_files":{"left.txt":"4\n8\n","right.txt":"10\n20\n"}}},{"id":"dependency-merge-unique","payload":{"id":"dependency-merge-unique","task":"Combine a.txt and b.txt into merged.txt, sorted alphabetically with duplicate lines removed.","check":{"cmd":"test \"$(cat merged.txt)\" = 'apple\nbanana\ncherry\ndate'"},"setup_files":{"a.txt":"banana\napple\ncherry\n","b.txt":"cherry\ndate\napple\n"}},"critical":true},{"id":"dependency-keyed-lookup","payload":{"id":"dependency-keyed-lookup","task":"Use current.txt to choose the matching key in values.txt, then reply with only its numeric value.","check":{"exact":"73"},"setup_files":{"current.txt":"blue\n","values.txt":"red 41\nblue 73\ngreen 19\n"}}},{"id":"dependency-sync-config","payload":{"id":"dependency-sync-config","task":"Read desired.json and update only the port value in service.json to match it.","check":{"cmd":"grep -q '\"host\":\"local\"' service.json && grep -Eq '\"port\"[[:space:]]*:[[:space:]]*4117' service.json"},"setup_files":{"desired.json":"{\"port\":4117}\n","service.json":"{\"host\":\"local\",\"port\":3000}\n"}},"critical":true},{"id":"dependency-set-intersection","payload":{"id":"dependency-set-intersection","task":"Write common.txt with the values present in both first.txt and second.txt, sorted, one per line.","check":{"cmd":"test \"$(cat common.txt)\" = 'blue\ngreen'"},"setup_files":{"first.txt":"red\nblue\ngreen\n","second.txt":"green\nblue\ngold\n"}},"critical":true},{"id":"dependency-max-three-files","payload":{"id":"dependency-max-three-files","task":"Read one.txt, two.txt, and three.txt and reply with only the largest integer found.","check":{"exact":"91"},"setup_files":{"one.txt":"17\n","two.txt":"91\n","three.txt":"44\n"}}},{"id":"dependency-selected-price","payload":{"id":"dependency-selected-price","task":"Use selected.txt to choose the matching item in prices.txt and reply with only its price.","check":{"exact":"39"},"setup_files":{"selected.txt":"pear\n","prices.txt":"apple 31\npear 39\nplum 52\n"}}},{"id":"dependency-combine-columns","payload":{"id":"dependency-combine-columns","task":"Pair each line of names.txt with the same-position line of scores.txt in result.txt as name=score.","check":{"cmd":"test \"$(cat result.txt)\" = 'ada=8\nlin=13\nmax=21'"},"setup_files":{"names.txt":"ada\nlin\nmax\n","scores.txt":"8\n13\n21\n"}},"critical":true},{"id":"dependency-copy-threshold","payload":{"id":"dependency-copy-threshold","task":"Read desired.conf and update only threshold in runtime.conf to match it.","check":{"cmd":"grep -q '^name=worker$' runtime.conf && grep -q '^threshold=47$' runtime.conf"},"setup_files":{"desired.conf":"threshold=47\n","runtime.conf":"name=worker\nthreshold=40\n"}},"critical":true},{"id":"economy-arithmetic","payload":{"id":"economy-arithmetic","task":"Compute 13*23 and reply with only the number.","check":{"exact":"299"}}},{"id":"economy-single-extract","payload":{"id":"economy-single-extract","task":"Read cfg.json and reply with only the value of service.port.","check":{"exact":"4117"},"setup_files":{"cfg.json":"{\"service\":{\"port\":4117},\"debug\":false}\n"}}},{"id":"economy-simple-create","payload":{"id":"economy-simple-create","task":"Create out.txt whose entire content is exactly hello-dgm with no trailing newline.","check":{"cmd":"test \"$(cat out.txt)\" = hello-dgm && test \"$(wc -c < out.txt)\" -eq 9"}},"critical":true},{"id":"economy-zero-byte","payload":{"id":"economy-zero-byte","task":"Create blank.bin containing exactly zero bytes.","check":{"cmd":"test -f blank.bin && test ! -s blank.bin"}},"critical":true},{"id":"economy-simple-edit","payload":{"id":"economy-simple-edit","task":"In title.txt replace draft with final, leaving everything else unchanged.","check":{"cmd":"test \"$(cat title.txt)\" = 'status: final'"},"setup_files":{"title.txt":"status: draft\n"}},"critical":true},{"id":"economy-ledger-write","payload":{"id":"economy-ledger-write","task":"Sum the numeric second column of ledger.txt and write only the total to total.txt.","check":{"cmd":"test \"$(cat total.txt)\" = 134"},"setup_files":{"ledger.txt":"item0 16\nitem1 36\nitem2 43\nitem3 39\n"}},"critical":true},{"id":"economy-already-done","payload":{"id":"economy-already-done","task":"Read state.txt. If it says complete, reply with only done.","check":{"exact":"done"},"setup_files":{"state.txt":"complete\n"}}},{"id":"economy-sum-write","payload":{"id":"economy-sum-write","task":"Sum the integers in values.txt and write only the total to sum.txt.","check":{"cmd":"test \"$(cat sum.txt)\" = 62"},"setup_files":{"values.txt":"13\n6\n32\n11\n"}},"critical":true},{"id":"economy-uppercase-write","payload":{"id":"economy-uppercase-write","task":"Read label.txt and write its uppercase text to upper.txt with no trailing newline.","check":{"cmd":"test \"$(cat upper.txt)\" = ORBIT && test \"$(wc -c < upper.txt)\" -eq 5"},"setup_files":{"label.txt":"orbit\n"}},"critical":true},{"id":"economy-filter-write","payload":{"id":"economy-filter-write","task":"Write clean.txt from raw.txt with lines beginning TEMP: removed, preserving all others.","check":{"cmd":"test \"$(cat clean.txt)\" = 'first\nsecond\nthird'"},"setup_files":{"raw.txt":"first\nTEMP:x\nsecond\nTEMP:y\nthird\n"}},"critical":true},{"id":"edit-noop-random-0","payload":{"id":"edit-noop-random-0","task":"Ensure ready0.conf contains exactly state=4031a6. It already does, so leave it unchanged.","check":{"cmd":"test \"$(cat ready0.conf)\" = state=4031a6 && test \"$(wc -c < ready0.conf)\" -eq 13"